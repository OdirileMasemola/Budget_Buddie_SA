<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid white background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Right border effect -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#E8DFF8" />
        </shape>
    </item>
</layer-list>