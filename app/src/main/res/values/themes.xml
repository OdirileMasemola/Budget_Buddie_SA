<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Budget_Buddie_SA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Budget_Buddie_SA" parent="Base.Theme.Budget_Buddie_SA" />

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedInput" parent="">
        <item name="cornerSize">14dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="OutlinedInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#7C3AED</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">#FFFFFF</item>
        <item name="hintTextColor">#9B8EC0</item>
        <item name="android:textColorHint">#C4B8DC</item>
        <item name="shapeAppearanceOverlay">@style/RoundedInput</item>
    </style>

    <style name="ToolbarTitleAppearance" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2D1B6B</item>
    </style>
</resources>